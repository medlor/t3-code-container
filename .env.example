# Trusted bash configuration, sourced by scripts/sandbox.sh.
# Environment / make command-line variables take precedence over this file.
# Use a dedicated project on the WSL Linux filesystem for proper Unix permissions.
PROJECT_DIR="${HOME}/projects/my-project"
SANDBOX=main
HOST_PORT=3773

# Mount these host directories read/write inside the container home.
# Set SHARE_HOST_STATE=0 for private T3/provider state instead.
SHARE_HOST_STATE=1
# Set to 0 to share provider credentials while running alongside your host T3.
SHARE_HOST_T3_STATE=1
HOST_T3_DIR="${HOME}/.t3"
HOST_CODEX_DIR="${HOME}/.codex"
HOST_CLAUDE_DIR="${HOME}/.claude"

# Every SANDBOX gets its own container and persistent home volume for other files.
# The image is shared by sandboxes belonging to the same Linux user.
# IMAGE=localhost/t3-code-sandbox:$(id -u)
UBUNTU_IMAGE=docker.io/library/ubuntu:rolling
NODE_IMAGE=docker.io/library/node:24-bookworm-slim
CODEX_VERSION=latest
CLAUDE_VERSION=latest
T3_VERSION=latest

# Optional resource limits. Set MEMORY/CPUS empty to omit those limits.
MEMORY=8g
CPUS=4
PIDS_LIMIT=2048
# Automatic Podman timers require a working systemd user session. make smoke
# and startup readiness checks work without it.
AUTO_HEALTHCHECK=0

# Optional Podman-format env file, passed only at runtime. Never baked into image.
# RUNTIME_ENV_FILE="${HOME}/.config/t3-sandbox/main.env"
